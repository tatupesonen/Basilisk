# Line endings (ADR-022). Text files keep the platform's line endings in a
# checkout, so a Windows checkout with core.autocrlf has CRLF: the product
# reads specifications with either ending, and tests and snapshots must
# pass both ways. Only what a CRLF would break is pinned here.
* text=auto

# Shell scripts and patches are read by tools that take CR as content.
*.sh    text eol=lf
*.patch text eol=lf

# Binary fixtures and assets: never converted.
*.so  binary
*.o   binary
*.gz  binary
*.png binary

# The vendored binutils tree is byte-for-byte upstream (MANIFEST holds its
# SHA-256 hashes): never convert its line endings.
vendor/** -text
# insta snapshots are compared as text written with LF; keep them LF on Windows checkouts.
*.snap text eol=lf

# Website screenshots (docs/features/site-screenshots/)
*.jpg binary
*.woff2 binary

# Oracle captures (output of the reference consoles, decomp_bk): formats
# with LF line ends whose readers are exact and reject a CR. Keep them LF.
crates/bk-testkit/tests/data/oracle/** text eol=lf
crates/bk-testkit/tests/data/oracle/*.gz binary
fixtures/decomp-oracle/** text eol=lf

# Inputs of the printer spike (data-test format, read by the reference consoles).
docs/research/decomp-out-spike/inputs/** text eol=lf
