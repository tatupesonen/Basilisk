load file frag/a15_struct_known.a64-gcc-O2.xml
option readonly on
parse line typedef uint8 size_t;
parse line typedef int8 ssize_t;
parse line extern void *memcpy(void *dst, void *src, size_t n);
parse line extern void *memset(void *dst, int4 c, size_t n);
parse line extern size_t strlen(char *s);
parse line extern int4 strcmp(char *a, char *b);
parse line extern char *strcpy(char *dst, char *src);
parse line extern int4 printf(char *fmt, ...);
parse line extern int4 puts(char *s);
parse line extern void *malloc(size_t n);
parse line extern void free(void *p);
parse line extern void exit(int4 status);
parse line extern void abort(void);
parse line extern ssize_t read(int4 fd, void *buf, size_t n);
parse line extern ssize_t write(int4 fd, void *buf, size_t n);
parse line extern int4 open(char *path, int4 flags, ...);
parse line extern int4 close(int4 fd);
parse line extern void __stack_chk_fail(void);
option noreturn exit
option noreturn abort
option noreturn __stack_chk_fail
parse line struct item { int4 id; char name[20]; float8 w; };
parse line extern float8 total(item *v, int4 n);
parse line extern item *find(item *v, int4 n, int4 id);
load function total
override flow r0x4010c2 callreturn
override flow r0x4010dc callreturn
decompile
decompile
print C
load function find
override flow r0x4010c2 callreturn
override flow r0x4010dc callreturn
decompile
decompile
print C
quit
