---
// The Basilisk logo (assets/brand/basilisk-logo*.svg): mark plus the
// stroke-drawn wordmark. The wordmark takes the text colour, so one copy
// serves both themes; the mark and the pupil-shaped i-dots use --bk-mark.
interface Props {
  height?: number;
  class?: string;
}
const { height = 28, class: cls } = Astro.props;
const width = Math.round((height * 711) / 256);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 711 256"
  width={width}
  height={height}
  class:list={['bk-logo', cls]}
  role="img"
  aria-label="Basilisk"
>
  <g fill="var(--bk-mark)" transform="translate(-16 0)">
    <path
      fill-rule="evenodd"
      d="M158.9 52.9 A100 100 0 1 0 207.9 87.8 L207.8 89.2 C207.8 93 208.2 96.3 208.5 99.6 C209.1 107.4 209.2 114.6 208.9 121.3 C208.2 133.3 206.1 143.9 203 153.6 C198.4 168 191.8 180.4 183.2 191.1 C172 204.9 155.2 213.7 138 215.7 C120.8 217.7 103 212.8 89.5 202.6 C76 192.4 66.7 177 64 160.7 C61.4 144.3 65.2 127.3 74.3 113.9 C83.4 100.6 97.6 91.1 113 87.8 L128 114 L199 83 L202 72 Z M150 73 L184 79.5 L156 87 Z"
    ></path>
    <path d="M95.1 55.1 L88.4 26.3 L116.3 45.7 L128 4 L139.7 45.7 L167.6 26.3 L160.9 55.1 Z"></path>
    <path class="bk-mark-pupil" d="M128 126 A63.1 63.1 0 0 1 128 210 A63.1 63.1 0 0 1 128 126 Z"></path>
  </g>
  <g transform="translate(244 81.4) scale(0.74)">
    <path
      fill="none"
      stroke="currentColor"
      stroke-width="16"
      d="M8 0 V140 M8 8 H49 A29 29 0 0 1 49 66 H8 M8 66 H51 A33 33 0 0 1 51 132 H8 M198 40 V140 M114 90 a42 42 0 1 0 84 0 a42 42 0 1 0 -84 0 M292.9 60.6 C287.6 52.2 276.9 48 264 48 C246.9 48 235.1 56.4 235.1 68 C235.1 81.6 249 85.8 264 90 C279 94.2 292.9 98.4 292.9 112 C292.9 123.6 281.1 132 264 132 C251.1 132 240.4 127.8 234 118.3 M328 40 V140 M368 0 V140 M408 40 V140 M500.9 60.6 C495.6 52.2 484.9 48 472 48 C454.9 48 443.1 56.4 443.1 68 C443.1 81.6 457 85.8 472 90 C487 94.2 500.9 98.4 500.9 112 C500.9 123.6 489.1 132 472 132 C459.1 132 448.4 127.8 442 118.3 M536 0 V140"
    ></path>
    <path fill="currentColor" d="M540 87.5 H544 L583.6 40 H604.4 L544 112.5 H540 Z M568.7 79.7 L607.5 140 H588.5 L555.3 88.3 Z"></path>
    <path fill="var(--bk-mark)" d="M328 -6 Q344.1 11 328 28 Q311.9 11 328 -6 Z M408 -6 Q424.1 11 408 28 Q391.9 11 408 -6 Z"></path>
  </g>
</svg>
