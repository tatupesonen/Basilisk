---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';
import { repo } from '../lib/site-config.mjs';

interface Props {
  current?: 'home' | 'docs' | 'status' | 'roadmap';
}
const { current } = Astro.props;
const base = import.meta.env.BASE_URL;
const links = [
  { id: 'docs', href: `${base}docs/`, label: 'Docs' },
  { id: 'status', href: `${base}status/`, label: 'Status' },
  { id: 'roadmap', href: `${base}roadmap/`, label: 'Roadmap' },
];
---

<header class="bk-header">
  <div class="bk-header-inner">
    <a class="bk-header-logo" href={base} aria-label="basilisk home" aria-current={current === 'home' ? 'page' : undefined}>
      <Logo height={30} />
    </a>
    <nav class="bk-nav" aria-label="Site">
      {
        links.map((l) => (
          <a href={l.href} aria-current={current === l.id ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
      <a href={repo} class="bk-nav-source">
        <Icon name="git-branch" size="16" />
        <span>Source</span>
      </a>
      <ThemeToggle />
    </nav>
  </div>
</header>
