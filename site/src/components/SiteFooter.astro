---
import Mark from './Mark.astro';
import { repo, ghidra, licence } from '../lib/site-config.mjs';
const base = import.meta.env.BASE_URL;
---

<footer class="bk-footer">
  <div class="bk-footer-inner">
    <div class="bk-footer-brand">
      <Mark size={36} />
      <p>
        <strong>Basilisk</strong> is a reimplementation of{' '}
        <a href={ghidra}>Ghidra</a> in Rust. It is an independent project, not affiliated with or endorsed by
        Ghidra’s authors or the National Security Agency.
      </p>
    </div>
    <nav class="bk-footer-links" aria-label="Footer">
      <div>
        <p class="bk-eyebrow">Project</p>
        <a href={`${base}docs/`}>Documentation</a>
        <a href={`${base}status/`}>Status</a>
        <a href={`${base}roadmap/`}>Roadmap</a>
      </div>
      <div>
        <p class="bk-eyebrow">Source</p>
        <a href={repo}>Repository</a>
        <a href={`${repo}/blob/master/LICENSE`}>Licence</a>
        <a href={`${repo}/blob/master/NOTICE`}>Notice</a>
      </div>
    </nav>
  </div>
  <div class="bk-footer-base">
    <span>Licensed {licence}</span>
    <span aria-hidden="true">·</span>
    <span>Code ported from Ghidra is used under the Apache License 2.0 (<a href={`${repo}/blob/master/NOTICE`}>NOTICE</a>)</span>
  </div>
</footer>
