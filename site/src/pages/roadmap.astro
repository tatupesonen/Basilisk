---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import { loadMilestones } from '../lib/plan';
import { inlineMarkdown } from '../lib/repo';
import { repo } from '../lib/site-config.mjs';
import '../styles/status.css';

const ms = loadMilestones();
const linkCode = (code: string) =>
  /^(features|research|inventory)\/[\w./-]+\.md$/.test(code) ? `${repo}/blob/master/docs/${code}` : undefined;
const stateLabel = { done: 'Complete', current: 'Current', planned: 'Planned' } as const;
---

<SiteLayout
  title="Roadmap"
  current="roadmap"
  description="basilisk's milestones from foundations to full parity with Ghidra, generated from the project plan."
>
  <header class="bk-page-head">
    <div class="bk-wrap">
      <p class="bk-eyebrow"><span class="bk-addr">0x70</span> Roadmap</p>
      <h1>From foundations to full parity.</h1>
      <p class="bk-lede">
        Eleven milestones, headless core first. Generated from <a class="bk-link" href={`${repo}/blob/master/docs/PLAN.md`}><code>docs/PLAN.md</code></a>;
        later milestones are intentionally coarse and are planned in detail when they are reached. The interface
        (M7) and the GNU disassembler (M10) were started early.
      </p>
    </div>
  </header>
  <div class="bk-wrap">
    <ol class="bk-roadmap">
      {
        ms.map((m) => {
          const done = m.items.filter((i) => i.done).length;
          return (
            <li class={`rm-${m.state}`} id={m.id.toLowerCase()} aria-current={m.state === 'current' ? 'step' : undefined}>
              <div class="bk-rm-marker" aria-hidden="true">
                <span class="bk-rm-node">
                  {m.state === 'done' && <Icon name="check" weight="bold" size="14" />}
                  {m.state === 'current' && <span class="bk-pupil" />}
                </span>
              </div>
              <div class="bk-rm-body">
                <p class="bk-rm-meta">
                  <span class="bk-rm-id">{m.id}</span>
                  <span class={`bk-rm-state`}>{stateLabel[m.state]}</span>
                  {m.items.length > 0 && (
                    <span class="bk-muted">
                      {done}/{m.items.length} tasks
                    </span>
                  )}
                </p>
                <h2>{m.title}</h2>
                {m.remark && <p class="bk-muted bk-rm-remark">{m.remark}</p>}
                {m.intro && <p class="bk-rm-intro" set:html={inlineMarkdown(m.intro, linkCode)} />}
                {m.items.length > 0 && (
                  <ul class="bk-rm-items">
                    {m.items.map((i) => (
                      <li class={i.done ? 'yes' : 'no'}>
                        <Icon name={i.done ? 'check-square' : 'square'} size="16" weight={i.done ? 'fill' : 'regular'} />
                        <span set:html={inlineMarkdown(i.text, linkCode)} />
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</SiteLayout>
