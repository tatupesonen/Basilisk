---
import SiteLayout from '../layouts/SiteLayout.astro';
import Mark from '../components/Mark.astro';
import Icon from '../components/Icon.astro';
import Kbd from '../components/Kbd.astro';
import Screenshot from '../components/Screenshot.astro';
import CodeSample from '../components/CodeSample.astro';
import StatusSummary from '../components/StatusSummary.astro';
import Milestones from '../components/Milestones.astro';
import { loadMilestones } from '../lib/plan';
import { loadParity } from '../lib/parity';
import { repo, ghidra } from '../lib/site-config.mjs';
import { listingLines, decompilerLines } from '../lib/samples';

const base = import.meta.env.BASE_URL;
const milestones = loadMilestones();
const current = milestones.find((m) => m.state === 'current');
const parity = loadParity();
const roles = ['mnemonic', 'register', 'number', 'label', 'function', 'global', 'variable', 'parameter', 'keyword', 'type', 'string', 'comment'];
---

<SiteLayout
  current="home"
  description="Basilisk is a reimplementation of Ghidra in Rust — loaders, SLEIGH, p-code, analysis, the decompiler and a desktop interface. Early development: see what works today and what is planned."
>
  <section class="bk-hero" aria-labelledby="hero-title">
    <div class="bk-wrap">
      <div class="bk-hero-grid">
        <div>
          <Mark size={64} class="bk-hero-small-mark" />
          <a class="bk-pill" href={`${base}roadmap/`}>
            <span class="bk-pupil" aria-hidden="true"></span>
            Early development{current && ` · now: ${current.id} ${current.title}`}
          </a>
          <h1 id="hero-title">Reverse engineering, rebuilt in Rust.</h1>
          <p class="bk-lede">
            Basilisk is a reimplementation of <a class="bk-link" href={ghidra}>Ghidra</a> — loaders, SLEIGH, p-code,
            analysis, the decompiler and a desktop interface. It reads Ghidra’s processor specifications unchanged.
            Today it disassembles every processor Ghidra ships; the decompiler is being ported.
          </p>
          <div class="bk-actions">
            <a class="bk-btn bk-btn-primary" href={`${base}docs/`}>Read the documentation <Icon name="arrow-right" size="16" /></a>
            <a class="bk-btn bk-btn-secondary" href={`${base}status/`}>What works today</a>
          </div>
        </div>
        <div class="bk-hero-term">
          <div class="bk-terminal">
            <div class="bk-terminal-bar"><Icon name="terminal-window" size="15" />basilisk disasm</div>
            <pre><code><span class="p">$ </span><span class="f">basilisk</span> disasm --language x86:LE:64:default \
    --base 0x401000 --hex 554889e58b45fc83c0015dc3 \
    --format text --no-pcode
<span class="ln" style="--i:0"><span class="d">0x401000  55        </span> <span class="m">PUSH</span> <span class="r">RBP</span></span>
<span class="ln" style="--i:1"><span class="d">0x401001  48 89 e5  </span> <span class="m">MOV</span>  <span class="r">RBP</span>,<span class="r">RSP</span></span>
<span class="ln" style="--i:2"><span class="d">0x401004  8b 45 fc  </span> <span class="m">MOV</span>  <span class="r">EAX</span>,dword ptr [<span class="r">RBP</span> + <span class="n">-0x4</span>]</span>
<span class="ln" style="--i:3"><span class="d">0x401007  83 c0 01  </span> <span class="m">ADD</span>  <span class="r">EAX</span>,<span class="n">0x1</span></span>
<span class="ln" style="--i:4"><span class="d">0x40100a  5d        </span> <span class="m">POP</span>  <span class="r">RBP</span></span>
<span class="ln" style="--i:5"><span class="d">0x40100b  c3        </span> <span class="m">RET</span></span></code></pre>
          </div>
          <p class="bk-hero-term-note">
            Works today, for all 150 of Ghidra’s processor languages. Column spacing is trimmed here; the text is the
            command’s. <a class="bk-link" href={`${base}docs/getting-started/first-disassembly/`}>Try it</a>
          </p>
        </div>
      </div>
      <div class="bk-hero-shot">
        <Screenshot
          name="main"
          alt="Basilisk's main window: Program Trees and Symbol Tree on the left, the Listing in the centre, the Decompiler on the right and the Console below, showing the function main of the demo program."
          caption="The CodeBrowser layout Ghidra users know: Listing, Decompiler, trees and tables, on Basilisk’s built-in demo program."
          sizes="(min-width: 1200px) 1152px, calc(100vw - 32px)"
          widths={[640, 960, 1440, 2000]}
          eager
        />
      </div>
    </div>
  </section>

  <section class="bk-section bk-hero-after" aria-labelledby="interface-title">
    <div class="bk-wrap">
      <div class="bk-section-head">
        <div>
          <p class="bk-eyebrow"><span class="bk-addr">0x10</span> The interface</p>
          <h2 class="bk-h2" id="interface-title">If you know Ghidra, you already know Basilisk.</h2>
          <p class="bk-lede">
            The windows are where Ghidra puts them, with Ghidra’s names, menus and default keys. It runs on a built-in
            demo program until Basilisk can load real binaries.
          </p>
        </div>
      </div>

      <div class="bk-features">
        <div class="bk-feature">
          <h3><Icon name="keyboard" size="18" />Ghidra’s keys</h3>
          <p>Go to, rename, comment and the rest keep Ghidra’s default bindings, taken from its source.</p>
          <p><Kbd keys="G" /> <Kbd keys="L" /> <Kbd keys=";" /> <Kbd keys="Ctrl+Shift+F" /></p>
        </div>
        <div class="bk-feature">
          <h3><Icon name="magnifying-glass" size="18" />A palette for everything</h3>
          <p>One field searches every action, function, label, string and address.</p>
          <p><Kbd keys="Ctrl+Shift+P" /></p>
        </div>
        <div class="bk-feature">
          <h3><Icon name="squares-four" size="18" />Panes that move</h3>
          <p>Dock, stack and split any pane, or pop it out into its own window; the layout is remembered.</p>
        </div>
        <div class="bk-feature">
          <h3><Icon name="circle-half" size="18" />Calm, in two themes</h3>
          <p>Both themes use the same twelve syntax colours, one per kind of token.</p>
        </div>
      </div>

      <div class="bk-gallery">
        <Screenshot
          name="palette-detail"
          alt="The command palette open over the main window, matching rc4 against functions, data and strings."
          caption="Command palette: actions and locations in one list."
          sizes="(min-width: 900px) 370px, calc(100vw - 32px)"
          widths={[480, 760, 1080]}
        />
        <Screenshot
          name="hover-preview-detail"
          alt="Hovering a function name in the Listing shows a preview of the code at its target."
          caption="Hover a name to preview what it points at."
          sizes="(min-width: 900px) 370px, calc(100vw - 32px)"
          widths={[480, 760, 1080]}
        />
        <Screenshot
          name="references-detail"
          alt="The References window lists every reference to log_msg, beside the Console."
          caption="Every reference to a name in one filterable table."
          sizes="(min-width: 900px) 370px, calc(100vw - 32px)"
          widths={[480, 760, 1080]}
        />
      </div>
    </div>
  </section>

  <section class="bk-section bk-section-chrome" aria-labelledby="code-title">
    <div class="bk-wrap">
      <div class="bk-section-head">
        <div>
          <p class="bk-eyebrow"><span class="bk-addr">0x20</span> Listing and Decompiler</p>
          <h2 class="bk-h2" id="code-title">Colour that means something.</h2>
          <p class="bk-lede">
            Put the cursor on a statement in the Decompiler and the Listing marks the instructions it came from. Each
            of the twelve kinds of token has its own colour, checked for contrast in both themes.
          </p>
        </div>
      </div>
      <div class="bk-code-pair">
        <CodeSample title="Listing: licd" icon="list" label="Listing of main in the demo program" lines={listingLines} />
        <CodeSample title="Decompile: main - (licd)" icon="brackets-curly" label="Decompiled main in the demo program" lines={decompilerLines} />
      </div>
      <div class="bk-legend" aria-label="Syntax roles">
        {
          roles.map((r) => (
            <span class={`t-${r}`}>
              <i />
              <span style="color: var(--bk-text-2)">{r}</span>
            </span>
          ))
        }
      </div>
      <p class="bk-muted" style="margin-top: var(--bk-space-5); font-size: var(--bk-text-sm)">
        Set as text from the demo program the interface ships with. Real binaries arrive with the program model
        (milestone M4).
      </p>
    </div>
  </section>

  <section class="bk-section" aria-labelledby="status-title">
    <div class="bk-wrap">
      <div class="bk-section-head">
        <div>
          <p class="bk-eyebrow"><span class="bk-addr">0x30</span> Where it stands</p>
          <h2 class="bk-h2" id="status-title">Early, and honest about it.</h2>
          <p class="bk-lede">
            Basilisk is built from the bottom up: language files, then SLEIGH, then the decompiler, then programs and
            analysis. The summary on the right is generated from the project’s parity matrix (updated {parity.updated}).
          </p>
        </div>
        <a class="bk-arrow-link" href={`${base}status/`}>Full status matrix <Icon name="arrow-right" size="16" /></a>
      </div>

      <div class="bk-split">
        <div>
          <div class="bk-panel">
            <h3>Works today</h3>
            <ul class="bk-checklist">
              <li class="yes"><Icon name="check" weight="bold" size="16" /><span><strong>The desktop interface</strong> on a built-in demo program: Listing, Decompiler view, trees, tables, search, Go To, the palette, rename and comment dialogs, docking and pop-out windows.</span></li>
              <li class="yes"><Icon name="check" weight="bold" size="16" /><span><strong>Disassembly and p-code for every processor Ghidra ships</strong>: <code>basilisk disasm</code> decodes bytes with any of the 150 SLEIGH languages, with the same result as Ghidra’s engine.</span></li>
              <li class="yes"><Icon name="check" weight="bold" size="16" /><span><strong>The SLEIGH compiler</strong>: <code>basilisk sleigh compile</code> produces the same <code>.sla</code> content as Ghidra’s compiler for all 150 specifications, in under five seconds for the lot.</span></li>
              <li class="yes"><Icon name="check" weight="bold" size="16" /><span><strong>The first parts of the decompiler</strong>: types, value ranges, calling conventions and control-flow structuring, each checked against Ghidra’s decompiler.</span></li>
              <li class="yes"><Icon name="check" weight="bold" size="16" /><span><strong>Foundations</strong>: Ghidra’s language and compiler specifications read unchanged, ELF parsing, the p-code model and float formats.</span></li>
            </ul>
          </div>
        </div>
        <div>
          <StatusSummary />
          <div class="bk-panel" style="margin-top: var(--bk-space-6)">
            <h3>Not yet</h3>
            <ul class="bk-checklist">
              <li class="no"><Icon name="circle-dashed" size="16" /><span>Opening a real binary, analysis, decompiling a function and Python scripting. Each has its milestone on the <a class="bk-link" href={`${base}roadmap/`}>roadmap</a>.</span></li>
            </ul>
          </div>
        </div>
      </div>
      <Milestones />
    </div>
  </section>

  <section class="bk-section bk-section-chrome" aria-labelledby="why-title">
    <div class="bk-wrap">
      <div class="bk-section-head">
        <div>
          <p class="bk-eyebrow"><span class="bk-addr">0x40</span> Why Basilisk</p>
          <h2 class="bk-h2" id="why-title">Everything Ghidra does. Then better.</h2>
        </div>
      </div>
      <dl class="bk-stats">
        <div><dt>150 / 150</dt><dd>SLEIGH specifications compile to the same content as with Ghidra’s compiler</dd></div>
        <div><dt>39</dt><dd>processor families disassemble and lift to p-code like Ghidra’s engine</dd></div>
        <div><dt>2,400+</dt><dd>tests, most of them comparing against Ghidra on the same input</dd></div>
        <div><dt>3</dt><dd>systems built and tested on every change: Linux, macOS, Windows</dd></div>
      </dl>
      <div class="bk-why">
        <div>
          <h3>Parity first</h3>
          <p>Module by module, headless core first. Ghidra’s processor specifications work unchanged, and each feature lands with Ghidra’s own tests for it ported.</p>
        </div>
        <div>
          <h3>Better where it can be</h3>
          <p>Behaviour comes from Ghidra and structure from Rust. Each deliberate difference is recorded with its reason.</p>
        </div>
        <div>
          <h3>Fast, and never waiting</h3>
          <p>Language load, disassembly and decompilation at least as fast as Ghidra’s, analysis in parallel where safe, and an interface that never blocks.</p>
        </div>
        <div>
          <h3>Trustworthy</h3>
          <p>Parsers are fuzzed and must return an error, not crash, on a malformed file. Output is compared with Ghidra’s on the same input.</p>
        </div>
        <div>
          <h3>Python plugins</h3>
          <p>Scripts, analyzers, loaders and exporters in Python through an embedded interpreter, and Basilisk importable from Python. Planned for milestone M9.</p>
        </div>
        <div>
          <h3>One binary, three systems</h3>
          <p>Windows, macOS and Linux are built and tested on every change. Basilisk is a single binary.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bk-section" aria-labelledby="build-title">
    <div class="bk-wrap">
      <div class="bk-split">
        <div>
          <p class="bk-eyebrow"><span class="bk-addr">0x50</span> Try it</p>
          <h2 class="bk-h2" id="build-title">Build it from source.</h2>
          <p class="bk-lede">There are no releases yet. Building takes a Rust toolchain and a few minutes.</p>
          <ol class="bk-steps">
            <li><span><strong>Install Rust</strong> with rustup; it picks up the pinned toolchain from <code>rust-toolchain.toml</code>.</span></li>
            <li><span><strong>Clone and run.</strong> The interface opens on its demo program.</span></li>
            <li><span><strong>Find your way</strong> with the keys you know from Ghidra.</span></li>
            <li><span><strong>Disassemble something.</strong> <a class="bk-link" href={`${base}docs/getting-started/first-disassembly/`}>Your first disassembly</a> takes five minutes.</span></li>
          </ol>
        </div>
        <div>
          <div class="bk-terminal">
            <div class="bk-terminal-bar"><Icon name="terminal-window" size="15" />shell</div>
            <pre><code><span class="p">$ </span>git clone {repo}
<span class="p">$ </span>cd Basilisk
<span class="p">$ </span><span class="f">cargo</span> run --release -p basilisk
<span class="c"># the interface opens on its built-in demo program</span>

<span class="c"># or disassemble bytes with one of Ghidra's languages</span>
<span class="p">$ </span><span class="f">basilisk</span> disasm --language x86:LE:64:default \
    --hex 554889e5c3 --format text --no-pcode
0x0  55                       PUSH RBP
0x1  48 89 e5                 MOV RBP,RSP
0x4  c3                       RET</code></pre>
          </div>
          <div class="bk-keys-row">
            <div><span>Command palette</span><Kbd keys="Ctrl+Shift+P" /></div>
            <div><span>Go to</span><Kbd keys="G" /></div>
            <div><span>Rename</span><Kbd keys="L" /></div>
            <div><span>Set comment</span><Kbd keys=";" /></div>
            <div><span>Back / forward</span><Kbd keys="Alt+←" /></div>
            <div><span>References to</span><Kbd keys="Ctrl+Shift+F" /></div>
          </div>
          <p class="bk-muted" style="margin-top: var(--bk-space-5); font-size: var(--bk-text-sm)">
            Ctrl is Cmd on macOS, as in Ghidra. <a class="bk-link" href={`${base}docs/getting-started/build/`}>Build instructions</a> · <a class="bk-link" href={`${base}docs/`}>Documentation</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bk-section bk-section-chrome" aria-labelledby="credit-title">
    <div class="bk-wrap">
      <div class="bk-credit">
        <Mark size={72} />
        <div>
          <p class="bk-eyebrow"><span class="bk-addr">0x60</span> Credit</p>
          <h2 class="bk-h2" id="credit-title" style="font-size: var(--bk-text-2xl)">Standing on Ghidra’s work.</h2>
          <p style="margin-top: var(--bk-space-5)">
            Basilisk reimplements <a class="bk-link" href={ghidra}>Ghidra</a>, the software reverse-engineering
            framework developed at the National Security Agency and published under the Apache License 2.0. Basilisk
            ports its behaviour and its tests, and reads its processor specifications as they are.
          </p>
          <p>
            Basilisk is an independent project. It is not affiliated with, sponsored or endorsed by the NSA or Ghidra’s
            authors. It is free software under the GPL, version 3 or later; see the{' '}
            <a class="bk-link" href={`${repo}/blob/master/NOTICE`}>notice</a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
