---
import SiteLayout from '../layouts/SiteLayout.astro';
import Mark from '../components/Mark.astro';
const base = import.meta.env.BASE_URL;
---

<SiteLayout title="Not found" description="This page does not exist.">
  <section class="bk-page-head" style="border-bottom: 0; min-height: 60vh">
    <div class="bk-wrap" style="display: grid; gap: var(--bk-space-6); justify-items: start">
      <Mark size={72} />
      <p class="bk-eyebrow"><span class="bk-addr">0xdeadbeef</span> Not found</p>
      <h1>Nothing at this address.</h1>
      <p class="bk-lede">The page you followed does not exist, or has moved.</p>
      <div class="bk-actions" style="margin-top: 0">
        <a class="bk-btn bk-btn-primary" href={base}>Basilisk home</a>
        <a class="bk-btn bk-btn-secondary" href={`${base}docs/`}>Documentation</a>
      </div>
    </div>
  </section>
</SiteLayout>
