+
+// ---- sla-host-diff instrumentation (not Ghidra code) ----
+// With SLEIGH_TRACE_SCORE set, every decision node runs the field choice
+// twice more with explicit arithmetic: mode 0 computes sc -= p*log(p) as
+// one fused multiply-subtract (std::fma, what AArch64 compilers emit),
+// mode 1 rounds the product first (what x86-64 without FMA does). Where
+// the two choices differ, the node, both choices and the scores of the
+// competing fields are printed as hexadecimal floats on stderr.
+
+double DecisionNode::traceScore(int4 low,int4 size,bool context,int4 mode)
+
+{
+  int4 numBins = 1 << size;
+  uintm m = (((uintm)1)<<size) - 1;
+  int4 total = 0;
+  vector<int4> count(numBins,0);
+  for(int4 i=0;i<list.size();++i) {
+    uintm mask = list[i].first->getMask(low,size,context);
+    if ((mask&m)!=m) continue;
+    uintm val = list[i].first->getValue(low,size,context);
+    total += 1;
+    count[val] += 1;
+  }
+  if (total <= 0) return -1.0;
+  double sc = 0.0;
+  for(int4 i=0;i<numBins;++i) {
+    if (count[i] <= 0) continue;
+    if (count[i] >= list.size()) return -1.0;
+    double p = ((double)count[i])/total;
+    double lp = log(p);
+    if (mode == 0)
+      sc = std::fma(-p, lp, sc);
+    else {
+      volatile double prod = p * lp;
+      sc = sc - prod;
+    }
+  }
+  return ( sc / log(2.0) );
+}
+
+void DecisionNode::traceChoose(int4 mode,int4 &sbitout,int4 &sizeout,bool &ctxout,double &scoreout)
+
+{				// chooseOptimalField with explicit arithmetic
+  double score = 0.0;
+  int4 sbit,size;
+  bool context;
+  double sc;
+  int4 maxlength,numfixed,maxfixed;
+  int4 bsbit = 0, bsize = 0; bool bctx = false;
+  maxfixed = 1;
+  context = true;
+  do {
+    maxlength = 8*getMaximumLength(context);
+    for(sbit=0;sbit<maxlength;++sbit) {
+      numfixed = getNumFixed(sbit,1,context);
+      if (numfixed < maxfixed) continue;
+      sc = traceScore(sbit,1,context,mode);
+      if ((numfixed > maxfixed)&&(sc > 0.0)) {
+	score = sc; maxfixed = numfixed; bsbit = sbit; bsize = 1; bctx = context;
+	continue;
+      }
+      if (sc > score) { score = sc; bsbit = sbit; bsize = 1; bctx = context; }
+    }
+    context = !context;
+  } while(!context);
+  context = true;
+  do {
+    maxlength = 8*getMaximumLength(context);
+    for(size=2;size <= 8;++size) {
+      for(sbit=0;sbit<maxlength-size+1;++sbit) {
+	if (getNumFixed(sbit,size,context) < maxfixed) continue;
+	sc = traceScore(sbit,size,context,mode);
+	if (sc > score) { score = sc; bsbit = sbit; bsize = size; bctx = context; }
+      }
+    }
+    context = !context;
+  } while(!context);
+  if (score <= 0.0) bsize = 0;
+  sbitout = bsbit; sizeout = bsize; ctxout = bctx; scoreout = score;
+}
+
+void DecisionNode::traceCompare(void)
+
+{
+  if (getenv("SLEIGH_TRACE_SCORE") == (char *)0) return;
+  int4 s0,z0,s1,z1; bool c0,c1; double sc0,sc1;
+  traceChoose(0,s0,z0,c0,sc0);
+  traceChoose(1,s1,z1,c1,sc1);
+  if (s0 == s1 && z0 == z1 && c0 == c1) return;
+  string path;
+  for(const DecisionNode *n = this; n->parent != (DecisionNode *)0; n = n->parent) {
+    const vector<DecisionNode *> &sib(n->parent->children);
+    int4 idx = -1;
+    for(int4 i=0;i<sib.size();++i) if (sib[i] == n) idx = i;
+    path = "/" + std::to_string(idx) + path;
+  }
+  const char *own = (startbit==s0 && bitsize==z0 && contextdecision==c0) ? "fused" :
+    ((startbit==s1 && bitsize==z1 && contextdecision==c1) ? "unfused" : "neither");
+  fprintf(stderr,"TIE table=%s node=root%s patterns=%d build=%s\n",trace_table_name.c_str(),path.c_str(),(int)list.size(),own);
+  fprintf(stderr,"  fused   picks %s[%d..+%d] score %a (%.17g)\n",c0?"ctx":"ins",s0,z0,sc0,sc0);
+  fprintf(stderr,"  unfused picks %s[%d..+%d] score %a (%.17g)\n",c1?"ctx":"ins",s1,z1,sc1,sc1);
+  // The scores of both fields under both arithmetics.
+  for(int4 k=0;k<2;++k) {
+    int4 s = k ? s1 : s0, z = k ? z1 : z0; bool c = k ? c1 : c0;
+    fprintf(stderr,"  field %s[%d..+%d]: fused %a unfused %a counts",c?"ctx":"ins",s,z,
+	    traceScore(s,z,c,0),traceScore(s,z,c,1));
+    uintm m = (((uintm)1)<<z) - 1;
+    vector<int4> cnt(1<<z,0);
+    for(int4 i=0;i<list.size();++i) {
+      if ((list[i].first->getMask(s,z,c)&m)!=m) continue;
+      cnt[list[i].first->getValue(s,z,c)] += 1;
+    }
+    for(int4 i=0;i<cnt.size();++i) if (cnt[i] > 0) fprintf(stderr," [%d]=%d",i,cnt[i]);
+    fprintf(stderr,"\n");
+  }
+}
+// ---- end of instrumentation ----
