define endian=big;
:a is epsilon {
  local t:4 = *[ram]:4 (r0 + 4);
  *:2 r1 = t:2;
  r2[0,8] = &:4 r3;
  if (r0 s< 0) goto <neg>;
  call [r1];
  goto 0x1000[ram];
  r0 = zext(r1 f+ r2) >> 3 & ~r4;
  build sub;
  crossbuild inst_next, other;
  sync();
  <neg>
  return [lr];
  export *[ram]:4 r0;
}
:b is epsilon {
  r0 = 1:4;
  <<other>>
  r1 = r2(2);
  <<third>>
}

